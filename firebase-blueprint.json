{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and balance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin", "payment_admin"] },
        "balance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Service order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "serviceId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "targetLink": { "type": "string" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string" },
        "providerOrderId": { "type": "string" },
        "providerStatus": { "type": "string" },
        "error": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Course": {
      "title": "Course",
      "description": "SMM Service definition",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "minLimit": { "type": "number" },
        "maxLimit": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "providerId": { "type": "string" },
        "providerServiceId": { "type": "string" }
      }
    },
    "Setting": {
      "title": "Setting",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "providerApiUrl": { "type": "string" },
        "providerApiKey": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Service orders"
    },
    "courses/{courseId}": {
      "schema": "Course",
      "description": "Available SMM services"
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "Global configuration"
    },
    "providers/{providerId}": {
      "schema": "object",
      "description": "SMM API providers"
    },
    "deposits/{depositId}": {
      "schema": "object",
      "description": "Payment deposits"
    },
    "stats/counters": {
      "schema": "object",
      "description": "Global stats"
    },
    "logs/{logId}": {
      "schema": "object",
      "description": "System logs"
    }
  }
}
