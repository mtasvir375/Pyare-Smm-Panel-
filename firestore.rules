rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'mtasvir375@gmail.com';
    }

    // User profiles: strictly locked! No normal user can ever update their balance or role!
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId 
        && (!('role' in request.resource.data) || request.resource.data.role == 'student' || isAdmin())
        && (!('balance' in request.resource.data) || request.resource.data.balance <= 1.0 || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Orders: users can only read their own and create pending orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Deposits: users can only submit pending deposit requests. Only admin can approve or modify.
    match /deposits/{depositId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid 
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Courses (Services): public read, admin-only write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Providers: strict admin-only
    match /providers/{providerId} {
      allow read, write: if isAdmin();
    }

    // Settings: public read for payment QR, admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Transactions: owner read, admin write
    match /transactions/{txnId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Payment Intents: owner read/create, admin-only update
    match /payment_intents/{intentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Bank Alerts & SMS Forwarder: strict admin-only
    match /bank_alerts/{alertId} {
      allow read, write: if isAdmin();
    }
    match /sms_forwarder_pool/{utr} {
      allow read, write: if isAdmin();
    }
    match /sms_forwarder_logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /pending_user_utrs/{utr} {
      allow read, write: if isAdmin();
    }
    match /api_keys/{apiKey} {
      allow read, write: if isAdmin();
    }
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
